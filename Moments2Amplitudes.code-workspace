{
	"folders": [
		{
			"path": "."
		}
	],
	"settings": {
		"files.associations": {
			"*.C": "cpp",
			"*.h": "cpp",
			"*.ipynb": "jupyter-notebook"
		},
		"C_Cpp.default.includePath": [
			"${workspaceFolder}/include",
			"${workspaceFolder}/src"
		],
		"C_Cpp.default.compilerPath": "/usr/bin/g++",
		"C_Cpp.default.cppStandard": "c++17",
		"C_Cpp.default.intelliSenseMode": "linux-gcc-x64",
		"files.exclude": {
			"**/.git": true,
			"**/__pycache__": true,
			"**/*.pyc": true
		},
		"search.exclude": {
			"**/.pixi": true,
			"**/node_modules": true,
			"**/*.root": true
		},
		"editor.formatOnSave": false,
		"editor.tabSize": 4,
		"editor.insertSpaces": true,
		"terminal.integrated.defaultProfile.linux": "bash",
		"terminal.integrated.cwd": "${workspaceFolder}"
	},
	"extensions": {
		"recommendations": [
			"ms-vscode.cpptools",
			"ms-vscode.cpptools-extension-pack",
			"ms-python.python",
			"ms-toolsai.jupyter",
			"jeff-hykin.better-cpp-syntax"
		]
	},
	"launch": {
		"version": "0.2.0",
		"configurations": []
	},
	"tasks": {
		"version": "2.0.0",
		"tasks": [
			{
				"label": "Load Library (brufit)",
				"type": "shell",
				"command": "bash -i -c 'source ${workspaceFolder}/set_env.sh && brufit -b -x -q Load.C'",
				"options": {
					"cwd": "${workspaceFolder}/macros"
				},
				"problemMatcher": [],
				"presentation": {
					"reveal": "always",
					"panel": "shared"
				}
			},
		]
	}
}
